<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/custom.css' | relative_url }}">
    {% if page.citation_title %}
      <meta name="citation_title" content="{{ page.citation_title | escape }}">
      {% for author in page.citation_authors %}
        <meta name="citation_author" content="{{ author | escape }}">
      {% endfor %}
      <meta name="citation_publication_date" content="{{ page.citation_publication_date }}">
      {% if page.citation_conference_title %}
        <meta name="citation_conference_title" content="{{ page.citation_conference_title | escape }}">
      {% endif %}
      {% if page.citation_firstpage %}
        <meta name="citation_firstpage" content="{{ page.citation_firstpage }}">
      {% endif %}
      {% if page.citation_lastpage %}
        <meta name="citation_lastpage" content="{{ page.citation_lastpage }}">
      {% endif %}
      {% if page.citation_pdf_url %}
        <meta name="citation_pdf_url" content="{{ page.citation_pdf_url }}">
      {% endif %}
    {% endif %}
  </head>
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    {% include header.liquid %}
    <div class="container mt-5" role="main">{{ content }}</div>
    {% include footer.liquid %}
    {% include scripts.liquid %}
  </body>
</html>
